        -:  324:        StimulusId::ST01_ESS, StimulusId::ST02_MultiTone, StimulusId::ST03_PureSine,
        -:  325:        StimulusId::ST04_WhiteNoise, StimulusId::ST05_PinkNoise, StimulusId::ST06_Impulse,
        -:  326:        StimulusId::ST16_LatencyRef,
        -:  327:        StimulusId::ST07_BurstTone, StimulusId::ST08_DynamicStep, StimulusId::ST09_Silence,
        -:  328:        StimulusId::ST10_HardAttack, StimulusId::ST11_SoftAttack, StimulusId::ST12_PulseTrain,
